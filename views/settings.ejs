<div class="flex justify-between items-center mb-6">
    <h3 class="text-2xl font-bold">Categories, Visibility and MOTD</h3>
</div>
<div class="flex justify-between gap-6">
    <div class="w-1/3 flex flex-col gap-6">
        <div>
            <form class="max-w-sm">
                <a class="block text-sm font-medium text-gray-400 mb-1">Select Categories</a>
                <select id="categories" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                    <option selected>Select Categories</option>
                    <option value="test">test</option>
                    <option value="test">test</option>
                </select>
            </form>
            <button onclick="updateCategories()" class="mt-3 bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg transition-all duration-200 transform hover:scale-105">
                Update Categories
            </button>
        </div>
        
        <div>
            <form class="max-w-sm">
                <a class="block text-sm font-medium text-gray-400 mb-1">Visibility</a>
                <select id="visibility" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                    <option value="true" selected>Visible</option>
                    <option value="false">Not Visible</option>
                </select>
            </form>
            <button onclick="updateVisibility()" class="mt-3 bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg transition-all duration-200 transform hover:scale-105">
                Update Visibility
            </button>
        </div>
    </div>

    <div class="w-1/2">
        <a class="block text-sm font-medium text-gray-400 mb-1 mx-right">MOTD</a>
        <div>
            <textarea id="motd-input" 
                class="w-full p-3 mb-3 bg-gray-800 bg-opacity-50 border border-gray-600 rounded-lg text-white resize-y min-h-[50px]" 
                style="resize: none;"
                placeholder="Loading MOTD..."
                rows="4">
            </textarea>
        </div>
        <div class="flex justify-end">
            <button onclick="changeMOTD()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg transition-all duration-200 transform hover:scale-105">
                Change MOTD
            </button>
        </div>
    </div>
</div>

<hr class="rounded-xl border-none h-0.5 bg-neutral-700 my-5">

<!-- Server Properties -->
<div class="flex justify-between items-center mb-6">
    <h3 class="text-2xl font-bold">Server Properties</h3>
    <div class="flex items-center gap-4">
        <div class="flex items-center">
            <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="advanced-mode" class="sr-only peer">
                <div class="w-11 h-6 bg-gray-700 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                <span class="ml-3 text-sm font-medium text-white">Advanced Mode</span>
            </label>
        </div>
        <button onclick="resetProps()" class="bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded-lg transition-all duration-200 transform hover:scale-105">
            Reset server.properties
        </button>
    </div>
</div>

<!-- Edit mode selector (hidden by default) -->
<select id="edit-mode" class="hidden w-full p-3 mb-6 bg-gray-800 bg-opacity-50 border border-gray-600 rounded-lg text-white">
    <option value="patch">Patch Mode</option>
    <option value="edit">Edit Mode</option>
</select>

<form id="properties-form" class="grid grid-cols-1 md:grid-cols-2 gap-6"></form>

<hr class="rounded-xl border-none h-0.5 bg-neutral-700 my-5">

<h3 class="text-xl font-semibold text-white mb-4">Custom Ports</h3>
<div id="port-management-root" class="space-y-4">
    <!-- Port items will be styled with these classes -->
    <div class="port flex items-center justify-between bg-gray-800 p-4 rounded-lg border border-gray-600">
        <span class="text-gray-200">Port details here</span>
        <button onclick="deletePort(port.id)" class="bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded-md transition-colors duration-200">
            Delete
        </button>
    </div>

    <!-- Input and add button container -->
    <div class="flex gap-3">
        <input type="number" id="new-port-input" 
            class="flex-1 bg-gray-800 text-white rounded-lg border border-gray-600 px-4 py-2 focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            placeholder="Enter port number (1024-65535)">
        <button onclick="createPort()" 
            class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg transition-colors duration-200">
            Add Port
        </button>
    </div>
</div>

<script>
// Variables
const MAX_PORTS = 2; // Seems to be the maximum amount of ports any server can have
let isAdvancedMode = false;
let serverProperties = {};

// Update Visibility state
async function updateVisibility() {
    try {
        const visibilityValue = document.getElementById('visibility').value === 'true' ? 1 : 0;
        const payload = JSON.stringify({ visibility: visibilityValue });
        await oHttp.post(`/proxy/server/${serverId}/visibility`, payload);
        alert('Visibility updated successfully');
    } catch (error) {
        errorAlert(`Failed to update visibility: ${error.connection?.response?.body || 'Unknown error'}`);
        console.error('Failed to update visibility:', error);
    }
}
// Add these functions near the top of your script section
async function fetchMOTD() {
    try {
        const response = await oHttp.get(`/proxy/server/${serverId}`);
        const motd = response.response.body.server.motd;
        document.getElementById('motd-input').value = motd || '';
    } catch (error) {
        errorAlert(`Failed to fetch MOTD: ${error.connection?.response?.body || 'Unknown error'}`);
        console.error('Failed to fetch MOTD:', error);
    }
}

async function changeMOTD() {
    try {
        const motd = document.getElementById('motd-input').value;
        await oHttp.post(`/proxy/server/${serverId}/change_motd`, { motd });
        alert('MOTD updated successfully');
    } catch (error) {
        errorAlert(`Failed to update MOTD: ${error.connection?.response?.body || 'Unknown error'}`);
        console.error('Failed to update MOTD:', error);
    }
}

function toggleNewPortMenu() {
    const menu = document.getElementById('new-port-menu');
    menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
}

function addPort() {
    const portList = document.getElementById('port-list');
    if (portList.children.length >= MAX_PORTS) {
        warningAlert('Maximum of ' + MAX_PORTS + ' ports reached.');
        return;
    }

    const portInput = document.getElementById('new-port-input');
    const portValue = parseInt(portInput.value, 10);

    if (portValue && portValue >= 1024 && portValue <= 65535) {
        const newPortItem = document.createElement('div');
        newPortItem.className = 'port-item';
        newPortItem.innerHTML = `Port ${portValue} <button onclick="deletePort(${portValue})">Delete</button>`;
        portList.appendChild(newPortItem);
        portInput.value = '';
        toggleNewPortMenu();
    } else {
        warningAlert('Please enter a valid port number (1024-65535).');
    }
}

async function fetchPorts() {
    try {
        const conn = await oHttp.get(`/proxy/v1/server/${serverId}/port`); // Port info is not provided by getData, so this is required.
        return conn.response.body;
    } catch (error) {
        errorAlert(`Failed to get ports: ${error.connection?.response?.body || 'Unknown error'}`)
        console.error('Failed to get ports:', error);
        return [];
    }
}

async function createPort() {
    try {
        const portInput = document.getElementById('new-port-input');
        const in_port = parseInt(portInput.value, 10);
        let type = 'TCP';
        const conn = await oHttp.post(`/proxy/v1/server/${serverId}/port`, { serverId: serverId, type, in_port });
        alert('Port created successfully: ' + conn.response.body.port);
        window.location.reload();
    } catch (error) {
        errorAlert(`Failed to open port: ${error.connection?.response?.body || 'Unknown error'}`)
        console.error('Failed to open port:', error);
    }
}

async function deletePort(portId) {
    try {
        await oHttp.delete(`/proxy/v1/server/${serverId}/port/${portId}`);
        alert('Port deleted successfully');
        window.location.reload();
    } catch (error) {
        errorAlert(`Failed to delete port: ${error.connection?.response?.body || 'Unknown error'}`)
        console.error('Failed to delete port:', error);
    }
}

async function loadPorts() {
    const ports = await fetchPorts();
    const root = document.getElementById('port-management-root');
    root.innerHTML = '';
    let numports = 0;

    if (ports && ports.length > 0) {
        ports.forEach(port => {
            numports += 1;
            const portDiv = document.createElement('div');
            portDiv.className = 'port flex items-center justify-between bg-gray-800 p-4 rounded-lg border border-gray-600';
            
            const portInfo = document.createElement('div');
            portInfo.className = 'flex items-center gap-4';
            
            const inPortInput = document.createElement('input');
            inPortInput.type = 'number';
            inPortInput.value = port.in_port;
            inPortInput.min = 1024;
            inPortInput.max = 65535;
            inPortInput.className = 'w-24 bg-gray-700 text-white px-2 py-1 rounded border border-gray-500';
            
            const portText = document.createElement('span');
            portText.className = 'text-gray-200';
            portText.textContent = `, External Port: ${port.ex_port}, IP: ${port.ip.ip}`;
            
            portInfo.appendChild(inPortInput);
            portInfo.appendChild(portText);
            
            const buttonGroup = document.createElement('div');
            buttonGroup.className = 'flex gap-2';

            const updateButton = document.createElement('button');
            updateButton.className = 'bg-blue-600 hover:bg-blue-700 text-white px-3 py-1 rounded-md transition-colors duration-200';
            updateButton.textContent = 'Update';
            updateButton.onclick = () => updateServerPort(port.id, parseInt(inPortInput.value, 10));

            const deleteButton = document.createElement('button');
            deleteButton.className = 'bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded-md transition-colors duration-200';
            deleteButton.textContent = 'Delete';
            deleteButton.onclick = () => deletePort(port.id);

            buttonGroup.appendChild(updateButton);
            buttonGroup.appendChild(deleteButton);

            portDiv.appendChild(portInfo);
            portDiv.appendChild(buttonGroup);
            root.appendChild(portDiv);
        });
    }

    if (numports < MAX_PORTS) {
        const inputContainer = document.createElement('div');
        inputContainer.className = 'flex gap-3';
        
        const newportInput = document.createElement('input');
        newportInput.type = 'number';
        newportInput.id = 'new-port-input';
        newportInput.placeholder = 'Enter port number';
        newportInput.min = 1024;
        newportInput.max = 65535;
        newportInput.className = 'flex-1 bg-gray-800 text-white rounded-lg border border-gray-600 px-4 py-2 focus:ring-2 focus:ring-blue-500 focus:border-transparent';

        const addPortButton = document.createElement('button');
        addPortButton.textContent = 'Add Port';
        addPortButton.className = 'bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg transition-colors duration-200';
        addPortButton.onclick = createPort;

        inputContainer.appendChild(newportInput);
        inputContainer.appendChild(addPortButton);
        root.appendChild(inputContainer);
    }
}

function updateServerPort(portId, in_port) {
    try {
        const url = `/proxy/v1/server/${serverId}/port`;
        const payload = JSON.stringify({
            id: portId,
            serverId: serverId,
            in_port: in_port
        });
    
        oHttp.patch(url, payload).then(loadPorts());
    }
    catch (error) {
        errorAlert(`Failed to update port: ${error.connection?.response?.body || 'Unknown error'}`)
        console.error('Failed to update port:', error);
    }
}

loadPorts();

function toggleAdvancedMode() {
    isAdvancedMode = document.getElementById('advanced-mode').checked;
    const editModeSelect = document.getElementById('edit-mode');
    editModeSelect.style.display = isAdvancedMode ? 'block' : 'none';
    renderPropertiesForm();
}

document.getElementById('advanced-mode').addEventListener('change', toggleAdvancedMode);

function getFieldType(key, value) {
    if (typeof value === 'boolean') return 'select-boolean';
    if (typeof value === 'number') return 'number';
    if (key === 'gamemode') return 'select-gamemode';
    if (key === 'difficulty') return 'select-difficulty';
    return 'text';
}

function createFieldHTML(key, value) {
    const label = key.split('-').map(word => 
        word.charAt(0).toUpperCase() + word.slice(1)
    ).join(' ');
    
    const baseInputClass = "w-full p-3 bg-gray-800 bg-opacity-50 border border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-white";
    const labelClass = "block text-sm font-medium text-gray-400 mb-1";

    // In advanced mode set everything to text input
    if (isAdvancedMode) {
        return `
            <div class="space-y-2">
                <label class="${labelClass}">${label}</label>
                <input type="text" name="${key}" 
                    value="${value}"
                    data-original-value="${value}"
                    class="${baseInputClass}">
            </div>
        `;
    }

    
    const fieldType = getFieldType(key, value);
    
    if (fieldType === 'select-boolean') {
        return `
            <div class="space-y-2">
                <label class="${labelClass}">${label}</label>
                <select name="${key}" class="${baseInputClass}" data-original-value="${value}">
                    <option value="true" ${value === true ? 'selected' : ''}>True</option>
                    <option value="false" ${value === false ? 'selected' : ''}>False</option>
                </select>
            </div>
        `;
    }
    
    if (fieldType === 'select-gamemode') {
        return `
            <div class="space-y-2">
                <label class="${labelClass}">${label}</label>
                <select name="${key}" class="${baseInputClass}" data-original-value="${value}">
                    ${['survival', 'creative', 'adventure', 'spectator'].map(opt => 
                        `<option value="${opt}" ${value === opt ? 'selected' : ''}>${opt.charAt(0).toUpperCase() + opt.slice(1)}</option>`
                    ).join('')}
                </select>
            </div>
        `;
    }
    
    if (fieldType === 'select-difficulty') {
        return `
            <div class="space-y-2">
                <label class="${labelClass}">${label}</label>
                <select name="${key}" class="${baseInputClass}" data-original-value="${value}">
                    ${['peaceful', 'easy', 'normal', 'hard'].map(opt => 
                        `<option value="${opt}" ${value === opt ? 'selected' : ''}>${opt.charAt(0).toUpperCase() + opt.slice(1)}</option>`
                    ).join('')}
                </select>
            </div>
        `;
    }
    
    return `
        <div class="space-y-2">
            <label class="${labelClass}">${label}</label>
            <input type="${fieldType}" name="${key}" 
                value="${value}"
                data-original-value="${value}"
                class="${baseInputClass}">
        </div>
    `;
}

function renderPropertiesForm() {
    const form = document.getElementById('properties-form');
    form.innerHTML = '';
    
    const currentProperties = serverData?.server_properties || {};
    
    Object.entries(currentProperties).sort().forEach(([key, value]) => {
        const div = document.createElement('div');
        div.className = 'mb-4';
        div.innerHTML = createFieldHTML(key, value);
        form.appendChild(div);
    });

    const submitBtn = document.createElement('button');
    submitBtn.className = 'col-span-1 md:col-span-2 mt-6 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg transition-all duration-200 transform hover:scale-105';
    submitBtn.textContent = 'Save Properties';
    submitBtn.onclick = submitProperties;
    form.appendChild(submitBtn);
}

async function submitProperties(e) {
    e.preventDefault();
    const form = document.getElementById('properties-form');
    const editMode = document.getElementById('edit-mode').value;
    const properties = {};
    let hasChanges = false;

    form.querySelectorAll('[name]').forEach(element => {
        const name = element.getAttribute('name');
        const originalValue = element.getAttribute('data-original-value');
        let currentValue = element.value;
        
        if (originalValue === 'true' || originalValue === 'false') {
            currentValue = currentValue === 'true';
        } else if (!isNaN(currentValue) && element.type === 'number') {
            currentValue = Number(currentValue);
        }
        
        let typedOriginalValue = originalValue;
        if (originalValue === 'true') typedOriginalValue = true;
        if (originalValue === 'false') typedOriginalValue = false;
        if (!isNaN(originalValue) && element.type === 'number') typedOriginalValue = Number(originalValue);

        if (editMode === 'patch' && currentValue !== typedOriginalValue) {
            properties[name] = currentValue;
            hasChanges = true;
        } else if (editMode === 'edit') {
            properties[name] = currentValue;
        }
    });

    if (editMode === 'patch' && !hasChanges) {
        alert('No changes detected');
        return;
    }

    try {
        await oHttp.other(
            `/proxy/server/${serverId}/${editMode}_server_properties`,
            editMode === 'edit' ? 'POST' : 'PATCH',
            JSON.stringify({ serverProperties: properties })
        );
        await restartServer();
        alert('Properties updated successfully');
    } catch (error) {
        errorAlert(`Failed to update server properties: ${error.connection?.response?.body || 'Unknown error'}`);
        console.error('Failed to update server properties:', error);
    }
}

document.addEventListener('DOMContentLoaded', () => {
    const editMode = document.getElementById('edit-mode');
    if (editMode) {
        editMode.value = 'patch';
    }
});

eventSystem.on('propertiesUpdate', () => {
    renderPropertiesForm();
});

// Call this when the page loads
const form = document.getElementById('properties-form');
if (!form) console.error('Couldnt find properties form');
document.addEventListener('DOMContentLoaded', fetchMOTD);

</script>