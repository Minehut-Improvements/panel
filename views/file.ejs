    }
}

async function unzipSelected() {
    if (selectedFiles.size !== 1) {
        errorAlert('Select exactly one archive file to extract');
        return;
    }
    
    const fileName = Array.from(selectedFiles)[0];
    if (!fileName.endsWith('.zip') || !fileName.endsWith('.tar') || !fileName.endsWith('.gz') || !fileName.endsWith('.xz')) {
        errorAlert('Selected file is not a archive');
        return;
    }
    
    try {
        const response = await oHttp.post(
            `/proxy/file/${serverId}/unzip/${cleanPath(currentPath + '/' + fileName)}`,
            {},
            {'content-type': 'application/json; charset=utf-8'}
        );
        
        if (response.response.code !== 200) throw new Error('Extraction failed');
        await loadDirectory(currentPath);
    } catch (error) {
        console.error(error);
        errorAlert(`Failed to extract ${fileName}: ${JSON.stringify(error?.connection?.response?.body) || error?.message || 'Unknown error'}`);
    }
}

async function createFolder() {
    const name = prompt('Enter folder name:');
    if (!name) return;

    try {
        const response = await oHttp.post(
            `/proxy/file/${serverId}/folder/create`,
            JSON.stringify({ name: name, directory: currentPath }),
            {'content-type': 'application/json; charset=utf-8'}
        );
        
        if (response.response.code !== 200) throw new Error('Failed to create folder');
        
        await loadDirectory(currentPath);
    } catch (error) {
        console.error(error);
        errorAlert(`Failed to create folder: ${JSON.stringify(error?.connection?.response?.body) || error?.message || 'Unknown error'}`);
    }
}

// Navigation
function navigatePath() {
    let path = document.getElementById('path-input').value;
    path = path ? (path.startsWith('/') ? path : '/' + path) : '/';
    loadDirectory(path);
}

function navigateDirectory(path) {
    loadDirectory(path);
}

function openSelected() {
    if (selectedFiles.size !== 1) {
        errorAlert('Select exactly one file to open');
        return;
    }
    
    const fileName = Array.from(selectedFiles)[0];
    
    // Get the file item element to check if it's a directory
    const fileItem = document.querySelector(`[data-filename="${fileName}"]`);
    if (!fileItem) return;
    
    const isDirectory = fileItem.dataset.isDir === 'true';
    
    if (isDirectory) {
        // If it's a directory, navigate into it
        navigateDirectory(cleanPath(currentPath + '/' + fileName));
    } else {
        // If it's a file, open it in the editor
        openFile(cleanPath(currentPath + '/' + fileName));
    }
}

async function openFile(path) {
    const ext = path.substring(path.lastIndexOf('.')).toLowerCase();
    if (!SUPPORTED_EXTENSIONS.includes((ext ? ext : ''))) {
      if (!await confirm('This file type may not display correctly. Open anyway?')) {
        return;
      }
    }

    loadFile(path);
    document.getElementById('editor-overlay').classList.remove('hidden');
    document.getElementById('editor-title').textContent = path.split('/').pop();
}

async function closeEditor() {
    if (fileContentModified && !(await confirm('You have unsaved changes. Close anyway?'))) {
        return;
    }
    const editor = document.getElementById('file-content');
    editor.disabled = true;
    editor.value = 'Loading...';
    document.getElementById('editor-overlay').classList.add('hidden');
    fileContentModified = false;
}

function showContextMenu(e, file) {
    const menu = document.getElementById('context-menu');
    const viewportWidth = window.innerWidth;
    const viewportHeight = window.innerHeight;
    
    // Calculate position relative to viewport
    let x = e.clientX;
    let y = e.clientY;
    
    // Adjust for menu size if it would overflow viewport
    if (x + menu.offsetWidth > viewportWidth) {
        x = viewportWidth - menu.offsetWidth;
    }
    
    if (y + menu.offsetHeight > viewportHeight) {
        y = viewportHeight - menu.offsetHeight;
    }
    
    // Set position relative to page including scroll
    menu.style.position = 'fixed';
    menu.style.left = `${x}px`;
    menu.style.top = `${y}px`;
    
    // Update selected count
    document.getElementById('context-menu-count').textContent = selectedFiles.size;
    
    // Show/hide options based on selection
    menu.querySelector('[onclick="openSelected()"]').style.display = 
        selectedFiles.size === 1 ? 'flex' : 'none';
    
    menu.querySelector('.unzip-option').style.display = 
        selectedFiles.size === 1 && file.name.endsWith('.zip') ? 'flex' : 'none';
    
    menu.classList.remove('hidden');
}

function toggleFileSelection(fileName) {
    if (selectedFiles.has(fileName)) {
        selectedFiles.delete(fileName);
    } else {
        selectedFiles.add(fileName);
    }
}

// Initialize
initializeFileManager();
fetchSFTPInfo();

// Handle beforeunload
window.onbeforeunload = () => {
    if (fileContentModified) {
        return 'You have unsaved changes. Are you sure you want to leave?';
    }
};
</script>