<script>
let currentPath = '/';
let currentFile = '';
let fileContentModified = false;
let selectedFiles = new Set();
let draggedItems = null;
const chunkSize = 10 * 1000 * 1000; // 10 MB chunks
let uploadProgress = new Map();
let controller = new AbortController();
let activeUpload = false;
let uploadCancelled = false;
let lastSelectedFile = null;
let shiftPressed = false;

// Fetch sftp creds
async function fetchSFTPInfo() {
    try {
        const response = await oHttp.get(`/proxy/v1/server/${serverId}/sftp`);
        if (response.response.code !== 200) throw new Error('Failed to fetch SFTP info');

        const sftpInfo = response.response.body;

        document.getElementById('sftp-username').value = sftpInfo.username;
        document.getElementById('sftp-password').value = sftpInfo.password;
        document.getElementById('sftp-hostname').value = 'ftp.dev.minehut.com';
        document.getElementById('sftp-port').value = '2223';
    } catch (error) {
        console.error('Error fetching SFTP info:', error);
        errorAlert('Failed to fetch SFTP information');
    }
}

// Reset sftp creds
async function resetSFTPCredentials() {
    try {
        const response = await oHttp.post(`/proxy/v1/server/${serverId}/sftp/reset`, null, {'content-type': 'application/json; charset=utf-8'});
        if (response.response.code !== 200) throw new Error('Failed to reset SFTP credentials');

        await fetchSFTPInfo();
        alert('SFTP credentials have been reset successfully');
    } catch (error) {
        console.error('Error resetting SFTP credentials:', error);
        errorAlert('Failed to reset SFTP credentials');
    }
}

// Safe extensions to open (aka text / configs that are human-readable)
const SUPPORTED_EXTENSIONS = [
  '.yml', '.yaml', '.json', '.txt', '.log', '.gz',
  '.sk', '.mcfunction', '.properties', '.csv',
  '.mcmeta', '.conf', '.lang', '.js', '.html',
  '.css', '.md', '.cfg', '.ini', '.sh'
];

// Shift key detection
document.addEventListener('keydown', (e) => {
    if (e.key === 'Shift') {
        shiftPressed = true;
        document.body.style.cursor = 'crosshair';
    }
});

document.addEventListener('keyup', (e) => {
    if (e.key === 'Shift') {
        shiftPressed = false;
        document.body.style.cursor = 'default';
    }
});

// File sorting utility
function sortFiles(files) {
    return files.sort((a, b) => {
        if (a.directory === b.directory) {
            return a.name.toLowerCase().localeCompare(b.name.toLowerCase());
        }
        return a.directory ? -1 : 1;
    });
}

// Path utilities
function cleanPath(path) {
    if (typeof path !== 'string') {
        path = String(path);
    }
    path = path.replace(/\/+/g, '/');
    if (path !== '/' && path.endsWith('/')) {
        path = path.slice(0, -1);
    }
    return path;
}

function getParentPath(path) {
    path = cleanPath(path);
    if (path === '/') return '/';
    path = path.replace(/\/$/, '');
    return path.substring(0, path.lastIndexOf('/')) || '/';
}

function getPathParts(path) {
    return path.split('/').filter(p => p !== '');
}

function isSubPath(parentPath, childPath) {
    const parent = getPathParts(parentPath);
    const child = getPathParts(childPath);
    return child.length > parent.length && 
           parent.every((part, i) => part === child[i]);
}

function isSamePath(path1, path2) {
    return cleanPath(path1) === cleanPath(path2);
}

// File manager initialization
function initializeFileManager() {
    const fileTree = document.getElementById('file-tree');
    
    fileTree.addEventListener('dragover', (e) => {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'copy';
        fileTree.classList.add('bg-gray-700');
    });

    fileTree.addEventListener('dragleave', () => {
        fileTree.classList.remove('bg-gray-700');
    });

    fileTree.addEventListener('drop', async (e) => {
        e.preventDefault();
        fileTree.classList.remove('bg-gray-700');
        
        const files = Array.from(e.dataTransfer.files);
        if (files.length > 0) {
            await handleFileDrop(files);
        }
    });

    document.addEventListener('click', () => {
        document.getElementById('context-menu').classList.add('hidden');
    });

    document.addEventListener('contextmenu', (e) => {
        if (e.target.closest('#file-tree')) {
            e.preventDefault();
        }
    });

    document.getElementById('file-content').addEventListener('input', () => {
        fileContentModified = true;
    });

    // Add keyboard shortcuts
    document.addEventListener('keydown', e => {
        if (selectedFiles.size === 0) return;
        
        if (e.key === 'Delete') {
            deleteSelected();
        } else if (e.key === 'F2') {
            renameSelected();
        }
    });

    loadDirectory('/');
}

function uploadFile() {
    document.getElementById('file-input').click();
}

function setupItemInteractions(item, file, path) {
    // Right-click to open context menu
    item.addEventListener('contextmenu', (e) => {
        e.preventDefault();
        
        if (shiftPressed) {
            multiSelect(file.name);
        } else {
            if (!selectedFiles.has(file.name)) {
                selectedFiles.clear();
                toggleFileSelection(file.name);
                item.querySelector('input[type="checkbox"]').checked = true;
            }
            showContextMenu(e, file);
        }
    });

    // Click handling
    item.addEventListener('click', (e) => {
        e.preventDefault();
        
        if (shiftPressed) {
            multiSelect(file.name);
        } else {
            if (file.directory) {
                navigateDirectory(cleanPath(path + '/' + file.name));
            } else {
                openFile(cleanPath(path + '/' + file.name));
            }
        }
    });

    // Drag and drop
    item.addEventListener('dragstart', (e) => {
        if (shiftPressed) {
            multiSelect(file.name);
        }
        
        if (!selectedFiles.has(file.name)) {
            selectedFiles.clear();
            toggleFileSelection(file.name);
        }
        
        draggedItems = Array.from(selectedFiles);
        item.classList.add('opacity-50');
        
        e.dataTransfer.setData('application/json', JSON.stringify(draggedItems));
        e.dataTransfer.effectAllowed = 'copyMove';
    });

    item.addEventListener('dragend', () => {
        item.classList.remove('opacity-50');
        draggedItems = null;
    });

    item.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (file.directory) {
            item.classList.add('bg-blue-900');
            e.dataTransfer.dropEffect = 'move';
        }
    });

    item.addEventListener('dragleave', () => {
        item.classList.remove('bg-blue-900');
    });

    item.addEventListener('drop', async (e) => {
        e.preventDefault();
        item.classList.remove('bg-blue-900');
        
        if (draggedItems && file.directory) {
            const targetPath = cleanPath(path + '/' + file.name);
            for (const draggedItem of draggedItems) {
                await moveFile(draggedItem, targetPath);
            }
            await loadDirectory(currentPath);
        }
    });
}

function multiSelect(fileName) {
    const fileList = Array.from(document.querySelectorAll('.file-item'));
    const currentIndex = fileList.findIndex(item => item.dataset.filename === fileName);
    const lastIndex = lastSelectedFile ? fileList.findIndex(item => item.dataset.filename === lastSelectedFile) : currentIndex;
    
    if (lastIndex !== -1 && currentIndex !== -1) {
        const [start, end] = [Math.min(lastIndex, currentIndex), Math.max(lastIndex, currentIndex)];
        
        for (let i = start; i <= end; i++) {
            const fileItem = fileList[i];
            const fileName = fileItem.dataset.filename;
            toggleFileSelection(fileName, true);
        }
    }
    
    lastSelectedFile = fileName;
}

// Directory loading
async function loadDirectory(path) {
    try {
        path = cleanPath(path);
        const response = await oHttp.get(`/proxy/file/${serverId}/list/${path}`);
        if (response.response.code !== 200) throw new Error('Failed to load directory');
        
        let files = response.response.body.files || response.response.body;
        if (!Array.isArray(files)) throw new Error('Invalid file data');
        
        const fileTree = document.getElementById('file-tree');
        fileTree.innerHTML = '';
        selectedFiles.clear();

        if (path !== '/') {
            addParentDirectoryItem(fileTree, path);
        }

        files = sortFiles(files);
        files.forEach(file => createFileItem(fileTree, file, path));

        currentPath = path;
        document.getElementById('path-input').value = path === '/' ? '' : path.substring(1);
    } catch (error) {
        console.error(error);
        errorAlert(`Failed to load directory: ${JSON.stringify(error?.connection?.response?.body) || error?.message || 'Unknown error'}`);
    }
}

function addParentDirectoryItem(container, path) {
    const item = document.createElement('div');
    item.className = 'flex items-center p-3 hover:bg-gray-700 cursor-pointer group';
    
    const icon = document.createElement('span');
    icon.className = 'mr-3 text-lg';
    icon.textContent = '📁';
    
    const details = document.createElement('div');
    details.className = 'flex-1';
    details.textContent = '..';
    
    item.appendChild(icon);
    item.appendChild(details);
    item.onclick = () => navigateDirectory(getParentPath(path));
    
    container.appendChild(item);
}

function createFileItem(container, file, path) {
    const item = document.createElement('div');
    item.className = 'flex items-center p-3 hover:bg-gray-700 cursor-pointer group';
    item.draggable = true;
    item.dataset.filename = file.name;
    item.dataset.isDir = file.directory
    
    const checkbox = document.createElement('input');
    checkbox.type = 'checkbox';
    checkbox.className = 'w-4 h-4 mr-3 rounded border-gray-600 text-blue-600 focus:ring-blue-500 focus:ring-offset-gray-800 bg-gray-700 cursor-pointer';
    
    // Handle multiple selection with shift key
    checkbox.onclick = (e) => {
        e.stopPropagation();
        handleFileSelection(file.name);
    };
    
    const icon = document.createElement('span');
    icon.className = 'mr-3 text-lg';
    icon.textContent = file.directory ? '📁' : '📄';
    
    const details = document.createElement('div');
    details.className = 'flex-1 flex items-center justify-between';
    
    const nameDiv = document.createElement('div');
    nameDiv.textContent = file.name;
    
    const metaDiv = document.createElement('div');
    metaDiv.className = 'text-sm text-gray-400';
    metaDiv.textContent = file.showSize ? filesize(file.size) : '';
    
    details.appendChild(nameDiv);
    details.appendChild(metaDiv);
    
    item.appendChild(checkbox);
    item.appendChild(icon);
    item.appendChild(details);

    setupItemInteractions(item, file, path);
    
    container.appendChild(item);
}

function handleFileSelection(fileName) {
    const fileTree = document.getElementById('file-tree');
    const items = Array.from(fileTree.querySelectorAll('[data-filename]'));
    const currentItem = items.find(item => item.dataset.filename === fileName);
    
    if (!currentItem) return;
    
    if (!shiftPressed) {
        // Clear selection if not using shift
        selectedFiles.clear();
        items.forEach(item => {
            item.classList.remove('bg-blue-100', 'bg-opacity-10');
            item.querySelector('input[type="checkbox"]').checked = false;
        });
    }
    
    if (shiftPressed) {
        const lastIndex = items.findIndex(item => item.dataset.filename === lastSelectedFile);
        const currentIndex = items.findIndex(item => item.dataset.filename === fileName);
        
        if (lastIndex !== -1) {
            const [start, end] = [Math.min(lastIndex, currentIndex), Math.max(lastIndex, currentIndex)];
            
            for (let i = start; i <= end; i++) {
                const item = items[i];
                const filename = item.dataset.filename;
                selectedFiles.add(filename);
                item.classList.add('bg-blue-100', 'bg-opacity-10');
                item.querySelector('input[type="checkbox"]').checked = true;
            }
        }
    } else {
        selectedFiles.add(fileName);
        currentItem.classList.add('bg-blue-100', 'bg-opacity-10');
        currentItem.querySelector('input[type="checkbox"]').checked = true;
    }
    
    lastSelectedFile = fileName;
}

function setupItemInteractions(item, file, path) {
    // Right-click to open context menu
    item.addEventListener('contextmenu', (e) => {
        e.preventDefault();
        if (!selectedFiles.has(file.name)) {
            selectedFiles.clear();
            toggleFileSelection(file.name);
            item.querySelector('input[type="checkbox"]').checked = true;
        }
        showContextMenu(e, file);
    });

    // Click handling
    item.addEventListener('click', (e) => {
        if (file.directory) {
            navigateDirectory(cleanPath(path + '/' + file.name));
        } else {
            openFile(cleanPath(path + '/' + file.name));
        }
    });

    // Drag and drop
    item.addEventListener('dragstart', (e) => {
        if (!selectedFiles.has(file.name)) {
            selectedFiles.clear();
            toggleFileSelection(file.name);
        }
        
        draggedItems = Array.from(selectedFiles);
        item.classList.add('opacity-50');
        
        // Store selected files in drag data
        e.dataTransfer.setData('application/json', JSON.stringify(draggedItems));
        e.dataTransfer.effectAllowed = 'copyMove';
    });

    item.addEventListener('dragend', () => {
        item.classList.remove('opacity-50');
        draggedItems = null;
    });

    item.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (file.directory) {
            item.classList.add('bg-blue-900');
            e.dataTransfer.dropEffect = 'move';
        }
    });

    item.addEventListener('dragleave', () => {
        item.classList.remove('bg-blue-900');
    });

    item.addEventListener('drop', async (e) => {
        e.preventDefault();
        item.classList.remove('bg-blue-900');
        
        if (draggedItems && file.directory) {
            const targetPath = cleanPath(path + '/' + file.name);
            for (const draggedItem of draggedItems) {
                await moveFile(draggedItem, targetPath);
            }
            await loadDirectory(currentPath);
        }
    });
}

function setupDragAndDrop(element, file, path) {
    element.addEventListener('dragstart', (e) => {
        draggedItem = file;
        element.classList.add('opacity-50');
    });

    element.addEventListener('dragend', () => {
        element.classList.remove('opacity-50');
        draggedItem = null;
    });

    element.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (file.directory) {
            element.classList.add('bg-blue-900');
        }
    });

    element.addEventListener('dragleave', () => {
        element.classList.remove('bg-blue-900');
    });

    element.addEventListener('drop', async (e) => {
        e.preventDefault();
        element.classList.remove('bg-blue-900');
        
        if (draggedItem && file.directory) {
            await moveFile(draggedItem.name, cleanPath(path + '/' + file.name));
        }
    });
}

// File operations
async function loadFile(path) {
    const editor = document.getElementById('file-content');
    editor.disabled = true;
    editor.value = 'Loading...';
    document.getElementById('save-btn').classList.add('disabled');
    
    try {
        const response = await oHttp.get(`/proxy/file/${serverId}/list/${currentPath}`);
        if (response.response.code !== 200) throw new Error('Failed to check file');
        
        let files = response.response.body.files || response.response.body;
        const file = files.find(f => f.name === path.split('/').pop());
        
        if (!file) throw new Error('File not found');
        
        if (file.tooLarge) {
            warningAlert('File too large to open');
            editor.value = 'File too large. Loading aborted.';
            return;
        }

        const fileResponse = await oHttp.get(`/proxy/file/${serverId}/read/${path}`);
        if (fileResponse.response.code !== 200) throw new Error('Failed to load file');
        
        editor.value = fileResponse.response.body.content;
        editor.disabled = false;
        document.getElementById('save-btn').classList.remove('disabled');
        currentFile = path;
        fileContentModified = false;
    } catch (error) {
        console.error(error);
        errorAlert(`Failed to load file: ${JSON.stringify(error?.connection?.response?.body) || error?.message || 'Unknown error'}`);
    }
}

async function saveFile() {
    if (!currentFile) return;
    
    try {
        const content = document.getElementById('file-content').value;
        const response = await oHttp.post(
            `/proxy/file/${serverId}/edit/${currentFile}`, 
            JSON.stringify({ content }),
            {'content-type': 'application/json; charset=utf-8'}
        );
        
        if (response.response.code !== 200) throw new Error('Failed to save file');
        
        alert('File saved successfully');
        fileContentModified = false;
    } catch (error) {
        console.error(error);
        errorAlert('Failed to save file: ' + error.message);
    }
}

// Upload handling
async function handleFileUpload() {
    const fileInput = document.getElementById('file-input');
    const files = Array.from(fileInput.files);
    if (files.length === 0) return;

    document.getElementById('upload-modal').classList.remove('hidden');
    uploadCancelled = false;
    activeUpload = true;

    for (const file of files) {
        if (uploadCancelled) break;
        await uploadFileWithChunks(file);
    }

    document.getElementById('upload-modal').classList.add('hidden');
    activeUpload = false;
    fileInput.value = '';
    await loadDirectory(currentPath);
}

async function uploadFileWithChunks(file) {
    const totalChunks = Math.ceil(file.size / chunkSize);
    const uploadId = crypto.randomUUID();
    let chunkCount = 0;

    try {
        while (chunkCount < totalChunks && !uploadCancelled) {
            const chunk = await createChunk(chunkCount, file, totalChunks);
            const form = new FormData();
            form.append('file', chunk, `${file.name}+${chunkCount}`);
            
            const headers = {
                'Upload-Id': uploadId,
                'Upload-Chunk-Number': chunkCount,
                'Upload-Chunk-Total': totalChunks,
                'content-type': 'application/json; charset=utf-8'
            };

            const response = await oHttp.post(
                `/manager/${serverId}/file/upload/${cleanPath(currentPath + '/' + file.name)}`,
                form,
                headers
            );
            
            if (response.response.code !== 200) throw new Error('Upload failed');
            
            chunkCount++;
            updateUploadProgress(chunkCount, totalChunks);
        }
    } catch (error) {
        console.error(error);
        errorAlert(`Failed to upload ${file.name}`);
        uploadCancelled = true;
        document.getElementById('upload-modal').classList.add('hidden');
        throw error;
    }
}

async function createChunk(chunkCount, file, totalChunks) {
    return new Promise((resolve) => {
        const reader = new FileReader();
        const start = chunkSize * chunkCount;
        const end = chunkCount + 1 === totalChunks ? file.size : start + chunkSize;

        reader.onload = () => {
            const chunk = new Blob([reader.result], { type: 'application/octet-stream' });
            resolve(chunk);
        };

        reader.readAsArrayBuffer(file.slice(start, end));
    });
}

function updateUploadProgress(chunkCount, totalChunks) {
    const percent = Math.round((chunkCount / totalChunks) * 100);
    document.getElementById('upload-progress-bar').style.width = `${percent}%`;
    document.getElementById('upload-progress-percent-text').textContent = `${percent}%`;
    document.getElementById('upload-progress-number-text').textContent = `${chunkCount} / ${totalChunks}`;
}

async function handleFileDrop(files) {
    document.getElementById('upload-modal').classList.remove('hidden');
    uploadCancelled = false;
    activeUpload = true;

    try {
        for (const file of files) {
            if (uploadCancelled) break;
            await uploadFileWithChunks(file);
        }
        await loadDirectory(currentPath);
    } finally {
        document.getElementById('upload-modal').classList.add('hidden');
        activeUpload = false;
    }
}

// File operations
async function deleteSelected() {
    if (selectedFiles.size === 0) return;
    
    if (!await confirm(`Delete ${selectedFiles.size} selected items?`)) return;
    
    try {
        const response = await oHttp.post(
            `/proxy/file/${serverId}/delete`,
            JSON.stringify({
                files: [selectedFiles]
            }),
            {'content-type': 'application/json; charset=utf-8'}
        );
        if (response.response.code !== 200) throw new Error('Delete failed');
    } catch (error) {
        console.error(error);
        errorAlert(`Failed to delete ${fileName}: ${JSON.stringify(error?.connection?.response?.body) || error?.message || 'Unknown error'}`);
    }
    
    await loadDirectory(currentPath);
}

async function renameSelected() {
    if (selectedFiles.size !== 1) {
        errorAlert('Select exactly one file to rename');
        return;
    }
    
    const oldName = Array.from(selectedFiles)[0];
    const newName = await prompt('Enter new name:', oldName);
    if (!newName) return;
    
    try {
        const response = await oHttp.post(
            `/proxy/file/${serverId}/rename/${currentPath}`,
            JSON.stringify({ name: cleanPath(currentPath + '/' + newName) }),
            {'content-type': 'application/json; charset=utf-8'}
        );
        
        if (response.response.code !== 200) throw new Error('Rename failed');
        await loadDirectory(currentPath);
    } catch (error) {
        console.error(error);
        errorAlert(`Failed to rename ${oldName}: ${JSON.stringify(error?.connection?.response?.body) || error?.message || 'Unknown error'}`);
    }
}

async function moveFile(fileName, targetPath) {
    const sourcePath = cleanPath(currentPath + '/' + fileName);
    const destPath = cleanPath(targetPath);
    
    if (isSamePath(sourcePath, destPath)) {
        warningAlert('Cannot move file to its current location');
        return false;
    }
    
    if (isSubPath(sourcePath, targetPath) || isSamePath(sourcePath, targetPath)) {
        warningAlert('Cannot move a folder into itself or its subfolder');
        return false;
    }
    
    try {
        const response = await oHttp.post(
            `/proxy/file/${serverId}/move`,
            JSON.stringify({
                files: [sourcePath],
                movePath: destPath,
                overwrite: true
            }),
            {'content-type': 'application/json; charset=utf-8'}
        );
        
        if (response.response.code !== 200) throw new Error('Move failed');
        return true;
    } catch (error) {
        console.error(error);
        errorAlert(`Failed to move ${fileName}: ${JSON.stringify(error?.connection?.response?.body) || error?.message || 'Unknown error'}`);
        return false;
    }
}

async function copyFile(fileName, targetPath) {
    const sourcePath = cleanPath(currentPath + '/' + fileName);
    const destPath = cleanPath(targetPath);
    
    if (isSamePath(sourcePath, destPath)) {
        warningAlert('Cannot copy file to its current location');
        return false;
    }
    
    try {
        const response = await oHttp.post(
            `/proxy/file/${serverId}/copy`,
            JSON.stringify({
                files: [sourcePath],
                copyPath: destPath,
                overwrite: true
            }),
            {'content-type': 'application/json; charset=utf-8'}
        );
        
        if (response.response.code !== 200) throw new Error('Copy failed');
        return true;
    } catch (error) {
        console.error(error);
        errorAlert(`Failed to copy ${fileName}: ${JSON.stringify(error?.connection?.response?.body) || error?.message || 'Unknown error'}`);
        return false;
    }
}

async function moveSelected() {
    if (selectedFiles.size === 0) return;
    
    const targetPath = await prompt('Enter destination path:', currentPath);
    if (!targetPath) return;
    
    let success = true;
    for (const fileName of selectedFiles) {
        if (!(await moveFile(fileName, targetPath))) {
            success = false;
        }
    }
    
    if (success) {
        await loadDirectory(currentPath);
    }
}

async function copySelected() {
    if (selectedFiles.size === 0) return;
    
    const targetPath = await prompt('Enter destination path:', currentPath);
    if (!targetPath) return;
    
    let success = true;
    for (const fileName of selectedFiles) {
        if (!(await copyFile(fileName, targetPath))) {
            success = false;
        }
    }
    
    if (success) {
