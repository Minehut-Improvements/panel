async function updateUserInfo() {
    try {
        userId = getCookie('minehut_id');
        if (!userId) {
            console.log('No userId available');
            window.location.href = "/";
            return;
        }
        const conn = await oHttp.get(`/proxy/v2/user/${userId}`);

        if (conn.response.code !== 200) {
            if (conn.response.body?.expired) {
                window.location.href = "/";
                return;
            }
            throw new Error(`API returned status ${response.response.code}`);
        }

        const prevUserData = userData;
        userData = conn.response.body;

        // Emit events for changes
        if (JSON.stringify(prevUserData) !== JSON.stringify(userData)) {
            eventSystem.emit('userUpdate', userData);
        }
        
        if (!prevUserData?.user?.credits || JSON.stringify(prevUserData?.user?.credits ?? -1) !== JSON.stringify(userData.user.credits)) {
            eventSystem.emit('creditUpdate', userData.user.credits);
        }
    } catch (error) {
        console.error('Failed to fetch user data:', error);
        document.getElementById('userCredits').innerText = 'Error';
    }
}

